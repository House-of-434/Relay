# Tool Layer settings. Secrets shared with the harness and BFF live in
# ../../.env.secrets, which loads first.
#
# The service role key belongs only here: the BFF is a browser boundary and
# must never hold it.

# All three must agree. RELAY_DB_URL must be HTTPS unless loopback outside
# production; see assertProjectUrl in src/database.ts.
RELAY_DB_PROJECT_REF=
RELAY_DB_URL=
RELAY_DB_SERVICE_ROLE_KEY=

# Gmail calls need the shared capability above; the mailbox is derived from
# the verified actor, never from the request.
# RELAY_BFF_INTERNAL_URL=http://127.0.0.1:8798