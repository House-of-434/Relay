# Tool Layer settings. Secrets shared with the chat harness and the BFF live in
# ../.env.secrets, which this service loads first.
#
# The Tool Layer connects with the service role key because it is the trusted
# backend that reads and writes on a member's behalf. Never copy this key into
# chat/.env: the BFF must not hold it.

# All three must agree, and RELAY_DB_URL must be HTTPS unless it is loopback in
# non-production. See assertProjectUrl in src/database.ts.
RELAY_DB_PROJECT_REF=
RELAY_DB_URL=
RELAY_DB_SERVICE_ROLE_KEY=

# Domain gate applied to every authenticated actor. Comma-separated.
RELAY_ALLOWED_EMAIL_DOMAINS=houseof434.com

# Optional. The Tool Layer refuses agent Gmail calls without the shared
# capability in ../.env.secrets, and derives the mailbox from the verified actor.
# RELAY_BFF_INTERNAL_URL=http://127.0.0.1:8798

# Optional read-only newsletter project. Configure all three or none.
# NEWSLETTER_READONLY_PROJECT_REF=
# NEWSLETTER_READONLY_URL=
# NEWSLETTER_READONLY_KEY=