    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "playwright": "1.56.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
