{
  "name": "@relay/scribe-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env.ingest --env-file-if-exists=../../.env.scribe --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "build:capture": "node scripts/build-capture.mjs",
    "test:vendored": "node scripts/run-vendored-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@vexa/gmeet-capture": "workspace:*",
    "@vexa/gmeet-pipeline": "workspace:*",
    "@vexa/transcribe-buffer": "workspace:*",
    "@vexa/transcribe-whisper": "workspace:*",
    "playwright": "1.56.0",
    "@vexa/zoom-capture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.25.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
