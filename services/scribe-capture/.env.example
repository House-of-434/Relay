# Scribe capture worker settings (slice 1: Meet).
#
# Two secrets only, each loaded from its own file (never root .env.secrets):
#   RELAY_SCRIBE_WORKER_CAPABILITY  -> .env.scribe (this worker + the harness)
#   RELAY_INGEST_CAPABILITY         -> .env.ingest (this worker + the Tool Layer)
# Neither the BFF capability nor any database key belongs in this service.

# HTTP endpoint the monitor calls (POST /join|/status|/stop).
RELAY_SCRIBE_HOST=127.0.0.1
RELAY_SCRIBE_PORT=8791

# Tool Layer ingest route (the single DB gate).
RELAY_INGEST_URL=http://127.0.0.1:8787/internal/transcripts

# Signed-in persistent Chromium profile (Google Meet as relay@). Separate from
# the research browser homes under /data/blade.
RELAY_SCRIBE_PROFILE_DIR=/data/scribe/profile

# Shared STT server (parakeet_server.py).
RELAY_STT_URL=http://127.0.0.1:8090

# Flush cadence: N segments or ms, whichever first.
RELAY_SCRIBE_FLUSH_SEGMENTS=50
RELAY_SCRIBE_FLUSH_MS=17500

# Concurrency cap; a meeting beyond this becomes failed "at capacity".
RELAY_SCRIBE_MAX_CONCURRENT=2

# Feature gate (0 disables joins).
RELAY_SCRIBE_ENABLED=1
