{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "description": "Relay — House of 434 internal intelligence workspace.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "relay": "node --experimental-strip-types server/relay.ts",
    "pair": "node --experimental-strip-types server/relay.ts pair",
    "dev:server": "node --env-file-if-exists=.env.secrets --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "dev:bff": "node --env-file-if-exists=.env.secrets --env-file-if-exists=.env --experimental-strip-types services/bff/server.ts",
    "test:bff": "node --experimental-strip-types --test services/bff/server.node-test.ts services/bff/google-api.node-test.ts services/bff/gmail-internal.node-test.ts services/bff/calendar-internal.node-test.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:relay": "node --experimental-strip-types scripts/control-relay.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run && pnpm test:bff && pnpm test:packaged-server",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "bench:persistence": "node --experimental-strip-types scripts/bench-persistence.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gen:bodies": "node --experimental-strip-types scripts/gen-mascot-bodies.ts",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "eval": "node --experimental-strip-types evals/run.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@hpke/core": "1.9.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@trycua/cua-driver": "0.28.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "googleapis": "^182.0.0",
    "jose": "6.2.10",
    "katex": "^0.16.47",
    "lucide-react": "^0.539.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^12.0.0",
    "qrcode-terminal": "0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tar": "7.5.22",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "oxlint": "1.80.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
