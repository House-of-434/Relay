# Shared by the harness, BFF and Tool Layer, each of which verifies what
# another signed or sent. Independent values of at least 32 bytes:
#
#   openssl rand -hex 32
#
# A mismatch does not fail at startup; it surfaces as every Gmail call being
# refused. Anything not needed by all three belongs in that service's .env.
RELAY_BFF_CAPABILITY=
RELAY_TOOL_ACTOR_SECRET=