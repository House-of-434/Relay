# Compose supplies defaults when these are omitted.
COMPOSE_PROJECT_NAME=relay
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_HTTP_PORT=8080
# Empty inherits http://localhost:${RELAY_HTTP_PORT:-8080}.
RELAY_PUBLIC_URL=
# Empty inherits RELAY_PUBLIC_URL.
RELAY_WEBHOOK_PUBLIC_URL=
# Tailscale Serve hostname, no scheme or path. Pair with an https://
# RELAY_PUBLIC_URL on the same hostname and a local HTTPS proxy.
RELAY_HTTPS_HOST=
# Local requests without a session receive service-level trust, not
# workspace-owner privileges. Required for shared deployments. Set to "owner"
# only in a private environment you fully control (a desktop build ignores it).
RELAY_LOOPBACK_TRUST=service
RELAY_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
RELAY_LOCAL_IMAGE=relay-local:latest
CADDY_IMAGE=caddy:2
# Engine CLIs baked into the image at build time (space-separated npm
# packages). Compose reads this as RELAY_ENGINES; explicitly empty skips the
# install step.
RELAY_ENGINES="@anthropic-ai/claude-code @openai/codex"
# Centralized default model every new bot inherits (and any bot with no
# selection of its own). Instance defaults to `claude`. Env wins over a value
# saved in Settings, so a managed deploy pins the workspace default here.
RELAY_DEFAULT_MODEL=
RELAY_DEFAULT_INSTANCE=claude

# Relay browser BFF. Add <RELAY_BFF_PUBLIC_URL>/auth/callback to the Supabase
# Auth redirect allowlist. HTTPS origins use Secure cookies.
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
# Tool Layer database access. The compose `tools` service reads ONLY the root
# .env + .env.secrets (not services/tool-layer/.env), so these three belong
# here for deployments. Same Supabase project as SUPABASE_* above; the
# service-role key is secret — dashboard → Project Settings → API.
RELAY_DB_URL=
RELAY_DB_PROJECT_REF=
RELAY_DB_SERVICE_ROLE_KEY=
# Allowlist for verified sign-in email domains (also enforced by the Tool Layer).
RELAY_ALLOWED_EMAIL_DOMAINS=
# Shared with the Tool Layer; normally in .env.secrets.
RELAY_BFF_CAPABILITY=
# Set to 1 when the BFF owns sign-in, or the harness refuses the session.
# Required (1) on any deploy that serves /auth/* through the BFF; the
# portal-session bridge 404s without it and sign-in fails closed.
# Set to 0 to run the standalone harness instead.
RELAY_PORTAL_SESSIONS=1
RELAY_BFF_PORT=8798
RELAY_BFF_PUBLIC_URL=http://localhost:8798
RELAY_TOOL_ACTOR_SECRET=
# The BFF calls the harness here.
RELAY_PORT=8799
# Vite UI port; the BFF accepts it only on loopback.
RELAY_UI_PORT=5199

# Empty uses <COMPOSE_PROJECT_NAME>_data.
RELAY_DATA_VOLUME=
# true only when reusing an existing volume.
RELAY_DATA_EXTERNAL=false

# Set to 0 to run the standalone harness instead of the shared workspace.
# RELAY_SHARED_WORKSPACE=1
# Composio and custom MCP servers are unavailable in a shared workspace.
# RELAY_DISABLE_COMPUTER=1

# Separate OAuth client and consent grant per connection. Register this exact
# callback URI on both; hosted deployments use their public HTTPS callback.
RELAY_GOOGLE_REDIRECT_URI=http://localhost:8798/api/google/oauth/callback
RELAY_CONN_GMAIL_CLIENT_ID=
RELAY_CONN_GMAIL_CLIENT_SECRET=
RELAY_CONN_CALENDAR_CLIENT_ID=
RELAY_CONN_CALENDAR_CLIENT_SECRET=
# 32-byte base64 or 64-char hex AES-256-GCM key for stored refresh tokens.
# Rotating it invalidates them and requires reconnecting.
RELAY_TOKEN_ENCRYPTION_KEY=
# Must be persistent storage in hosted deployments; it holds the encrypted
# Google connection file. Default ~/.relay.
# RELAY_DATA_DIR=