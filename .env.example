# Compose supplies defaults when these are omitted.
COMPOSE_PROJECT_NAME=relay
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_HTTP_PORT=8080
# Empty inherits http://localhost:${RELAY_HTTP_PORT:-8080}.
RELAY_PUBLIC_URL=
# Empty inherits RELAY_PUBLIC_URL.
RELAY_WEBHOOK_PUBLIC_URL=
# Tailscale Serve hostname, no scheme or path. Pair with an https://
# RELAY_PUBLIC_URL on the same hostname and a local HTTPS proxy.
RELAY_HTTPS_HOST=
# Local requests without a session receive service-level trust, not
# workspace-owner privileges. Required for shared deployments. Set to "owner"
# only in a private environment you fully control (a desktop build ignores it).
RELAY_LOOPBACK_TRUST=service
RELAY_LOCAL_IMAGE=relay-local:latest
CADDY_IMAGE=caddy:2
# Engine CLIs baked into the image at build time (space-separated npm
# packages). Compose reads this as RELAY_ENGINES; explicitly empty skips the
# install step.
RELAY_ENGINES="@anthropic-ai/claude-code @openai/codex"
# Centralized default model every new bot inherits (and any bot with no
# selection of its own). Instance defaults to `claude`. Env wins over a value
# saved in Settings, so a managed deploy pins the workspace default here.
RELAY_DEFAULT_MODEL=
RELAY_DEFAULT_INSTANCE=claude

# Relay browser BFF. Add <RELAY_BFF_PUBLIC_URL>/auth/callback to the Supabase
# Auth redirect allowlist. HTTPS origins use Secure cookies.
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
# Tool Layer database access. The compose `tools` service reads ONLY the root
# .env + .env.secrets (not services/tool-layer/.env), so these three belong
# here for deployments. Same Supabase project as SUPABASE_* above; the
# service-role key is secret — dashboard → Project Settings → API.
RELAY_DB_URL=
RELAY_DB_PROJECT_REF=
RELAY_DB_SERVICE_ROLE_KEY=
# Allowlist for verified sign-in email domains (also enforced by the Tool Layer).
# Shared with the Tool Layer; normally in .env.secrets.
RELAY_BFF_CAPABILITY=
# Set to 1 when the BFF owns sign-in, or the harness refuses the session.
# Required (1) on any deploy that serves /auth/* through the BFF; the
# portal-session bridge 404s without it and sign-in fails closed.
# Set to 0 to run the standalone harness instead.
RELAY_PORTAL_SESSIONS=1
RELAY_BFF_PORT=8798
RELAY_BFF_PUBLIC_URL=http://localhost:8798
RELAY_TOOL_ACTOR_SECRET=
# The BFF calls the harness here.
RELAY_PORT=8799
# Vite UI port; the BFF accepts it only on loopback.
RELAY_UI_PORT=5199

# Empty uses <COMPOSE_PROJECT_NAME>_data.
RELAY_DATA_VOLUME=
# true only when reusing an existing volume.
RELAY_DATA_EXTERNAL=false
# User-owned workspaces and thread files stay inside the data volume.
# Default: <RELAY_DATA_DIR>/users
RELAY_USERS_DIR=
# Scribe diagnostic retention (probes, failure screenshots, temporary status).
# Default: 30 days.
RELAY_SCRIBE_RETENTION_MS=2592000000

# Set to 0 to run the standalone harness instead of the shared workspace.
# RELAY_SHARED_WORKSPACE=1
# Custom MCP servers are unavailable in a shared workspace.
# RELAY_DISABLE_COMPUTER=1

# Separate OAuth client and consent grant per connection. Register this exact
# callback URI on both; hosted deployments use their public HTTPS callback.
RELAY_GOOGLE_REDIRECT_URI=http://localhost:8798/api/google/oauth/callback
RELAY_CONN_GMAIL_CLIENT_ID=
RELAY_CONN_GMAIL_CLIENT_SECRET=
RELAY_CONN_CALENDAR_CLIENT_ID=
RELAY_CONN_CALENDAR_CLIENT_SECRET=
# 32-byte base64 or 64-char hex AES-256-GCM key for stored refresh tokens.
# Rotating it invalidates them and requires reconnecting.
RELAY_TOKEN_ENCRYPTION_KEY=
# Relay's own shared Gmail account. Set BOTH to enable the shared mailbox:
# the address, and the Supabase user id that owns its connected Google
# account (set it explicitly; the session store is not a durable directory).
# Unset keeps the feature dark: no shared mailbox, no prompt paragraph.
# After relay@ signs in and connects Gmail AND Calendar, verify the scopes
# recorded in the BFF's google-connections.json include gmail.readonly +
# gmail.compose and calendar.readonly + calendar.events, and write them down.
RELAY_MAILBOX_ADDRESS=
RELAY_MAILBOX_USER_ID=
# Minutes between shared-mailbox polls (1-1440; default 1). A tick is one
# messages.list plus a read per unseen message; receipts dedupe, so 1 minute is
# cheap. Set higher to trade email latency for fewer Gmail calls.
RELAY_MAILBOX_POLL_MINUTES=
# Set to 0 to disable "finished while you were away" notification emails.
RELAY_MAILBOX_NOTIFY=
# Set to 1 only once Scribe (meeting transcription) ships. Until then,
# prompts must not promise that adding the shared address gets a meeting
# transcribed.
RELAY_SCRIBE_ENABLED=
# Scribe capture policy (compose sets defaults; override here as needed).
# Max simultaneous captures; a meeting beyond this becomes a `failed`
# "at capacity" row with a notice, never a silent drop.
# RELAY_SCRIBE_MAX_CONCURRENT=2
# Max concurrent per-participant audio streams per capture (each is an STT
# call site). 0 or unset → 12.
# RELAY_SCRIBE_MAX_STREAMS=12
# The bot's own display name, excluded from speaker binding.
# RELAY_SCRIBE_SELF_NAME=Relay Scribe
# 0 = headful under Xvfb (compose default; required by Zoom, which detects a
# headless browser and serves an anti-bot wall even with a signed-in profile).
# 1 = headless (Meet only).
# RELAY_SCRIBE_HEADLESS=0
# Comma-separated admins to alert when the Scribe browser profile is signed out
# (they can act; the organizer cannot). Only addresses that belong to a known
# member are used; if unset or none are known, the signed-out alert falls back
# to the organizer only and logs loudly. Rate-limited to one per 3 hours.
# RELAY_SCRIBE_ADMIN_EMAILS=
# Memory caps for the two Scribe services (measure before raising).
# RELAY_SCRIBE_MEM_LIMIT=4g
# RELAY_STT_MEM_LIMIT=3g
#
# The two Scribe capabilities live in their OWN gitignored files, not here:
#   .env.ingest  → RELAY_INGEST_CAPABILITY        (tools + scribe only)
#   .env.scribe  → RELAY_SCRIBE_WORKER_CAPABILITY (app + scribe only)
# See .env.ingest.example / .env.scribe.example.
# Must be persistent storage in hosted deployments; it holds the encrypted
# Google connection file. Default ~/.relay.
# RELAY_DATA_DIR=

# Research connectors (Scout). SEC and arXiv are operator-level values below;
# GitHub repository access is per-user (connected in the app), with optional
# App values below for private repositories.
# SEC EDGAR requires a declared fair-access User-Agent with contact information;
# without it the SEC connector is unavailable.
RELAY_SEC_USER_AGENT=
# Descriptive User-Agent sent to arXiv (a sensible default is used when empty).
RELAY_ARXIV_USER_AGENT=
# Optional GitHub App for private-repository access. Register the Setup URL as
# <RELAY_BFF_PUBLIC_URL>/api/github/callback. The private key belongs in
# .env.secrets and is never committed.
RELAY_CONN_GITHUB_APP_ID=
RELAY_CONN_GITHUB_APP_SLUG=
RELAY_CONN_GITHUB_APP_PRIVATE_KEY=
# Per-user Notion workspace connections (public OAuth integration). Register
# the callback as <RELAY_BFF_PUBLIC_URL>/api/notion/callback. The token key
# defaults to RELAY_TOKEN_ENCRYPTION_KEY when unset; set a dedicated key to
# rotate Notion tokens independently. Allowed database ids gate Notion writes
# server-side (comma-separated, dashes optional); during evaluation this holds
# only the Dealflow copy. Reads are unaffected.
RELAY_CONN_NOTION_CLIENT_ID=
RELAY_CONN_NOTION_CLIENT_SECRET=
RELAY_CONN_NOTION_TOKEN_KEY=
RELAY_NOTION_REDIRECT_URI=
RELAY_CONN_NOTION_ALLOWED_DATABASE_IDS=