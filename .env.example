# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=openmausbot
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# Leave empty to use http://localhost:${OMB_HTTP_PORT:-8080}.
OMB_PUBLIC_URL=
# Leave empty to inherit OMB_PUBLIC_URL.
OMB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set OMB_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
OMB_HTTPS_HOST=
OMB_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
OMB_LOCAL_IMAGE=openmausbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"

# Relay browser BFF. Set RELAY_BFF_PUBLIC_URL to the browser-reachable BFF origin
# (no path); it defaults to http://localhost:8798. Add
# <RELAY_BFF_PUBLIC_URL>/auth/callback to the Supabase Auth redirect
# allowlist. Local development returns to the Vite UI on OMB_UI_PORT; hosted
# deployments serve the UI at the configured public origin. HTTPS origins use
# Secure BFF cookies.
# Configure the Google identity client in Supabase's
# Google provider; RELAY_GOOGLE_IDENTITY_CLIENT_ID/SECRET do not belong here.
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
# RELAY_BFF_CAPABILITY and RELAY_TOOL_ACTOR_SECRET are shared with the Tool
# Layer and live in ../.env.secrets, which dev:server and dev:bff load before
# this file. Put them here only if you are deliberately not sharing them.
RELAY_BFF_CAPABILITY=
RELAY_BFF_PORT=8798
RELAY_BFF_PUBLIC_URL=http://localhost:8798
# The BFF also reads RELAY_TOOL_ACTOR_SECRET from ../.env.secrets so it can
# verify a harness actor assertion itself when an agent calls Gmail.
RELAY_TOOL_ACTOR_SECRET=
# The BFF calls the local harness at OMB_PORT (default 8799).
OMB_PORT=8799
# Local Vite UI port; the BFF accepts this port only on localhost/loopback.
OMB_UI_PORT=5199

# Leave empty for <COMPOSE_PROJECT_NAME>_data.
OMB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
OMB_DATA_EXTERNAL=false

# Relay shared workspace. Set to 0 to run the standalone harness instead.
# RELAY_SHARED_WORKSPACE=1
# The BFF is the membership authority and issues the browser's Relay session
# through the internal portal-session route. This must be 1 whenever the BFF owns
# sign-in: the harness only honors portal sessions when it is on, and honors them
# for hosted workspaces automatically when OMB_ADMIN_MEMBERSHIP=portal. Leaving
# it off while the BFF signs users in mints a session the harness then refuses.
# RELAY_PORTAL_SESSIONS=1
# Composio and custom MCP servers are unavailable in a shared workspace.
# RELAY_DISABLE_COMPUTER=1

# Google connections use separate OAuth clients and consent grants.
# Register this exact callback URI on both Google OAuth clients locally; hosted
# deployments must register their public HTTPS BFF callback URI instead.
RELAY_GOOGLE_REDIRECT_URI=http://localhost:8798/api/google/oauth/callback
RELAY_CONN_GMAIL_CLIENT_ID=
RELAY_CONN_GMAIL_CLIENT_SECRET=
RELAY_CONN_CALENDAR_CLIENT_ID=
RELAY_CONN_CALENDAR_CLIENT_SECRET=
# 32-byte base64 or 64-character hex AES-256-GCM key for stored refresh tokens.
# Rotating it makes existing encrypted tokens unavailable and requires reconnect.
RELAY_TOKEN_ENCRYPTION_KEY=
# OMB_DATA_DIR must point to persistent storage in hosted deployments; the
# encrypted Google connection file is stored there. Local default: ~/.openmausbot.
# OMB_DATA_DIR=
